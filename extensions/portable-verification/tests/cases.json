    {"id": "K06", "description": "last entry omitted, independent checkpoint", "supplied": [0, 1], "checkpoint": {"source": "independent", "count": 3, "head_link": "461cf1cad5fe45a896737bb01ae396639da7ef5c424352ab0d029565e0228552"}, "expected": "inconsistent_with_checkpoint"},
    {"id": "K07", "description": "all entries, independent checkpoint", "supplied": [0, 1, 2], "checkpoint": {"source": "independent", "count": 3, "head_link": "461cf1cad5fe45a896737bb01ae396639da7ef5c424352ab0d029565e0228552"}, "expected": "consistent_with_checkpoint"},
    {"id": "K08", "description": "last entry omitted, checkpoint supplied in the same export", "supplied": [0, 1], "checkpoint": {"source": "same_export", "count": 2, "head_link": "137c82021e36073e9a1d48c93dcc04d5ace7860df5ce60192f03387c5d0de8c7"}, "expected": "consistent", "limitation": "A checkpoint from the same export is not independent, so completeness stays not established."}
  ],
  "trust_cases": [
    {"id": "T01", "description": "key reference in the verifier's own policy", "check": "select_key", "key_ref": "issuer-a", "expected": {"trust": "trusted", "key": "key-a"}},
    {"id": "T02", "description": "untrusted key: the reference is not in the policy", "check": "select_key", "key_ref": "issuer-x", "expected": {"trust": "untrusted", "key": null}},
    {"id": "T03", "description": "self-supplied key: key material in the export is never used", "check": "select_key", "key_ref": "issuer-x", "export_key_material": "key-x", "expected": {"trust": "untrusted", "key": null}},
    {"id": "T04", "description": "wrong key: the export offers another key for a trusted reference; the policy's key is used, so a signature made with the other key fails", "check": "select_key", "key_ref": "issuer-a", "export_key_material": "key-x", "expected": {"trust": "trusted", "key": "key-a"}},
    {"id": "T05", "description": "key-reference substitution: signed bytes that bind the key reference differ, so a signature cannot be moved to another reference", "check": "signed_bytes", "record": "R0", "key_refs": ["issuer-a", "alias"], "expected": "differ"}
  ]
