  "digest_cases": [
    {"id": "D01", "description": "SHA-256 known value for 'abc' (FIPS 180-2)", "check": "known_vector", "text": "abc", "digest": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "expected": "match"},
    {"id": "D02", "description": "each record's recorded seal_hash is the SHA-256 of its bytes", "check": "record_seals", "expected": "match"},
    {"id": "D03", "description": "the chain links recorded above follow the link rule", "check": "chain_links", "expected": "match"},
    {"id": "D04", "description": "base_export carries the records' exact bytes, their seals and their links", "check": "base_export", "expected": "match"},
    {"id": "D05", "description": "payload mutation: one changed value is detected against the recorded seal", "check": "seal", "record": "R0", "edit": {"replace": "option B", "with": "option C"}, "expected": "mismatch"},
    {"id": "D06", "description": "a changed record re-sealed in the same export: matches that seal, not the original one", "check": "reseal", "record": "R0", "edit": {"replace": "option B", "with": "option C"}, "expected": {"same_export_seal": "match", "original_seal": "mismatch"}, "limitation": "A seal from the same export shows only that bytes and seal agree; the change shows against a seal held independently."},
    {"id": "D07", "description": "the same JSON value re-indented: equal as JSON, different bytes", "check": "seal", "record": "R0", "reserialise": "indent_2", "expected": "mismatch"},
    {"id": "D08", "description": "the same JSON value with sorted keys: equal as JSON, different bytes", "check": "seal", "record": "R0", "reserialise": "sorted_keys", "expected": "mismatch"},
    {"id": "D09", "description": "inserting the default record_type ('decision') changes the bytes; the seal matches only the bytes as sealed", "check": "seal", "record": "R1", "edit": {"replace": "\"record_state\"", "with": "\"record_type\":\"decision\",\"record_state\""}, "expected": "mismatch"},
    {"id": "D10", "description": "seal_hash_zeroed: the stored record, with its seal value zeroed, matches the seal", "check": "zeroed_seal", "record": "R2", "hash_as": "zeroed", "expected": "match"},
    {"id": "D11", "description": "seal_hash_zeroed: the stored record hashed as stored (seal value not zeroed) does not match", "check": "zeroed_seal", "record": "R2", "hash_as": "stored", "expected": "mismatch"}
  ],
